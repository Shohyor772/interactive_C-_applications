<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:core="clr-namespace:PilotNotes.Core;assembly=PilotNotes.Core"
             x:Class="NotesMaui.MainPage"
             x:DataType="core:NotesViewModel">

    <Grid Padding="16" RowSpacing="8" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
        
        <!-- Ввод новой заметки -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Grid.Column="0" Text="{Binding Draft, Mode=TwoWay}" Placeholder="Новая заметка" />
            <Button Grid.Column="1" Text="Добавить" Command="{Binding AddCommand}" />
        </Grid>

        <!-- Поиск -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Entry Grid.Column="0" Text="{Binding Query, Mode=TwoWay}" Placeholder="Поиск..." />
            <Button Grid.Column="1" Text="Найти" Command="{Binding SearchCommand}" />
            <Button Grid.Column="2" Text="Сброс" Command="{Binding ResetSearchCommand}" />
        </Grid>

        <!-- Список -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding VisibleNotes}" SelectedItem="{Binding SelectedNote, Mode=TwoWay}" SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="core:Note">
                    <Label Text="{Binding Text}" Padding="10,8" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Команды -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Button Grid.Column="0" Text="Удалить" Command="{Binding DeleteCommand}" />
            <Button Grid.Column="1" Text="Сохранить" Command="{Binding SaveCommand}" />
            <Button Grid.Column="2" Text="Загрузить" Command="{Binding LoadCommand}" />
        </Grid>

        <Label Grid.Row="4" Text="{Binding CountText}" FontAttributes="Bold" />
        <Label Grid.Row="5" Text="{Binding SaveState}" TextColor="Gray" />
        <Label Grid.Row="6" Text="{Binding Status}" TextColor="Blue" />
    </Grid>
</ContentPage>